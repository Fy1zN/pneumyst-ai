# Data
DATA_ROOT=C:\path\to\pneumyst-data

# MySQL
DATABASE_URL=mysql+pymysql://pneumyst:change-me@localhost:3306/pneumyst?charset=utf8mb4

# Auth: clerk verifies session tokens; dev skips verification and must never be used when deployed
AUTH_MODE=clerk
DEV_USER_ID=local-dev

# Clerk (backend)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pneumyst-artifacts
R2_ENDPOINT_URL=

# LLM (optional, report wording only)
LLM_API_KEY=

# API
CORS_ORIGINS=http://localhost:3000