# Data
DATA_ROOT=C:\path\to\pneumyst-data

# MySQL
DATABASE_URL=mysql+pymysql://pneumyst:change-me@localhost:3306/pneumyst?charset=utf8mb4

# Auth: clerk verifies session tokens; dev skips verification and must never be used when deployed
AUTH_MODE=clerk
DEV_USER_ID=local-dev

# Clerk (backend)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Image storage: files go to STORAGE_DIR, or DATA_ROOT/storage when it is empty
STORAGE_DIR=
FILE_SIGNING_KEY=
FILE_URL_TTL_S=300

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pneumyst-artifacts
R2_ENDPOINT_URL=

# LLM (optional): reports fall back to a template without a key
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_THINKING_LEVEL=
LLM_TIMEOUT_S=60

# API
CORS_ORIGINS=http://localhost:3000

# Hardening (defaults shown; 0 turns a rate limit off)
WARMUP=true
BACKGROUND_REPORTS=true
REPORT_DEADLINE_S=45
ASK_DEADLINE_S=60
RATE_ANALYZE_PER_HOUR=30
RATE_ASK_PER_HOUR=20